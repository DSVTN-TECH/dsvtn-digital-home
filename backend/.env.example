# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://dsvtn:dsvtn_dev@localhost:5432/dsvtn

# ─── Auth ─────────────────────────────────────────────────────
# REQUIRED: minimum 32 characters, random string
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars-long
JWT_EXPIRES_IN=7d

# ─── App ──────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# ─── Email (optional — app works without it, email will log) ──
EMAIL_API_KEY=
EMAIL_FROM=noreply@dsvtn.vn
