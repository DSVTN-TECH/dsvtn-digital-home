// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────

enum Role {
  ADMIN
  MEMBER
  LOGISTIC
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ActivityStatus {
  DRAFT
  OPEN
  CLOSED
  MATCHED
  COMPLETED
}

enum RegistrationStatus {
  SUBMITTED
  CANCELLED
}

enum AssignmentSource {
  MATCHER
  MANUAL
}

enum AssignmentStatus {
  PROPOSED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING_PAYMENT_REVIEW
  CONFIRMED
  REJECTED
  DELIVERED
  CANCELLED
}

enum EmailStatus {
  NOT_CONFIGURED
  SENT
  FAILED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ─── Models ───────────────────────────────────────────────────

model User {
  id            String     @id @default(uuid())
  fullName      String     @map("full_name")
  email         String     @unique
  passwordHash  String     @map("password_hash")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  role          Role
  fairnessScore Int        @default(0) @map("fairness_score")
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  volunteerApplicationsReviewed VolunteerApplication[] @relation("ReviewedBy")
  articles                      Article[]
  registrations                 ActivityRegistration[]
  assignments                   Assignment[]
  Activity                      Activity[]
  notifications                 Notification[]
  pointsLedger                  PointsLedger[]
  userBadges                    UserBadge[]
  streak                        Streak?
  galleryAlbums                 GalleryAlbum[]
  invitesSent                   Invite[]               @relation("InvitedBy")

  @@map("users")
}

model VolunteerApplication {
  id           String            @id @default(uuid())
  fullName     String            @map("full_name")
  email        String
  phone        String
  studentId    String            @map("student_id")
  note         String?
  status       ApplicationStatus @default(PENDING)
  emailStatus  EmailStatus       @default(NOT_CONFIGURED) @map("email_status")
  reviewedById String?           @map("reviewed_by")
  reviewedAt   DateTime?         @map("reviewed_at")
  createdAt    DateTime          @default(now()) @map("created_at")

  reviewedBy User? @relation("ReviewedBy", fields: [reviewedById], references: [id])

  @@index([status], name: "idx_volunteer_status")
  @@map("volunteer_applications")
}

model Article {
  id        String        @id @default(uuid())
  title     String
  slug      String        @unique
  content   String
  status    ArticleStatus @default(DRAFT)
  authorId  String        @map("author_id")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  author User @relation(fields: [authorId], references: [id])

  @@index([status], name: "idx_articles_status")
  @@map("articles")
}

model Activity {
  id          String         @id @default(uuid())
  title       String
  description String?
  startTime   DateTime       @map("start_time")
  endTime     DateTime       @map("end_time")
  status      ActivityStatus @default(DRAFT)
  createdById String         @map("created_by")
  createdAt   DateTime       @default(now()) @map("created_at")

  createdBy     User                   @relation(fields: [createdById], references: [id])
  tasks         Task[]
  registrations ActivityRegistration[]
  assignments   Assignment[]
  galleryAlbums GalleryAlbum[]

  @@map("activities")
}

model Task {
  id          String   @id @default(uuid())
  activityId  String   @map("activity_id")
  name        String
  description String?
  slotCount   Int      @map("slot_count")
  priority    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  activity    Activity         @relation(fields: [activityId], references: [id])
  preferences TaskPreference[]
  assignments Assignment[]

  @@map("tasks")
}

model ActivityRegistration {
  id          String             @id @default(uuid())
  activityId  String             @map("activity_id")
  userId      String             @map("user_id")
  status      RegistrationStatus @default(SUBMITTED)
  submittedAt DateTime           @default(now()) @map("submitted_at")

  activity    Activity         @relation(fields: [activityId], references: [id])
  user        User             @relation(fields: [userId], references: [id])
  preferences TaskPreference[]

  @@unique([activityId, userId])
  @@index([activityId, userId], name: "idx_reg_activity_user")
  @@map("activity_registrations")
}

model TaskPreference {
  id             String @id @default(uuid())
  registrationId String @map("registration_id")
  taskId         String @map("task_id")
  score          Int

  registration ActivityRegistration @relation(fields: [registrationId], references: [id])
  task         Task                 @relation(fields: [taskId], references: [id])

  @@unique([registrationId, taskId])
  @@map("task_preferences")
}

model Assignment {
  id         String           @id @default(uuid())
  activityId String           @map("activity_id")
  taskId     String           @map("task_id")
  userId     String           @map("user_id")
  source     AssignmentSource
  status     AssignmentStatus @default(PROPOSED)
  createdAt  DateTime         @default(now()) @map("created_at")

  activity Activity @relation(fields: [activityId], references: [id])
  task     Task     @relation(fields: [taskId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([activityId], name: "idx_assignments_activity")
  @@map("assignments")
}

model Product {
  id          String        @id @default(uuid())
  name        String
  description String?
  priceCents  Int           @map("price_cents")
  imageUrl    String?       @map("image_url")
  status      ProductStatus @default(ACTIVE)

  orderItems OrderItem[]

  @@map("products")
}

model Order {
  id              String      @id @default(uuid())
  customerName    String      @map("customer_name")
  customerPhone   String      @map("customer_phone")
  customerAddress String      @map("customer_address")
  paymentProofUrl String      @map("payment_proof_url")
  status          OrderStatus @default(PENDING_PAYMENT_REVIEW)
  emailStatus     EmailStatus @default(NOT_CONFIGURED) @map("email_status")
  campaignId      String?     @map("campaign_id")
  createdAt       DateTime    @default(now()) @map("created_at")

  items    OrderItem[]
  campaign Campaign?   @relation(fields: [campaignId], references: [id])

  @@index([status], name: "idx_orders_status")
  @@index([campaignId], name: "idx_orders_campaign")
  @@map("orders")
}

model OrderItem {
  id             String @id @default(uuid())
  orderId        String @map("order_id")
  productId      String @map("product_id")
  quantity       Int
  unitPriceCents Int    @map("unit_price_cents")

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  title     String
  body      String?
  linkUrl   String?   @map("link_url")
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead], name: "idx_notifications_user_read")
  @@map("notifications")
}

model Badge {
  id                String   @id @default(uuid())
  code              String   @unique
  name              String
  description       String?
  iconUrl           String?  @map("icon_url")
  criteriaType      String   @map("criteria_type")
  criteriaThreshold Int      @map("criteria_threshold")
  createdAt         DateTime @default(now()) @map("created_at")

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  badgeId   String   @map("badge_id")
  awardedAt DateTime @default(now()) @map("awarded_at")

  user  User  @relation(fields: [userId], references: [id])
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
  @@index([userId], name: "idx_user_badges_user")
  @@map("user_badges")
}

model PointsLedger {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  amount     Int
  reason     String
  sourceType String   @map("source_type")
  sourceId   String?  @map("source_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([sourceType, sourceId, reason])
  @@index([userId, createdAt], name: "idx_points_user_date")
  @@map("points_ledger")
}

model Streak {
  userId           String    @id @map("user_id")
  currentStreak    Int       @default(0) @map("current_streak")
  longestStreak    Int       @default(0) @map("longest_streak")
  lastActivityDate DateTime? @map("last_activity_date") @db.Date
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("streaks")
}

model GalleryAlbum {
  id            String   @id @default(uuid())
  title         String
  description   String?
  coverImageUrl String?  @map("cover_image_url")
  activityId    String?  @map("activity_id")
  createdById   String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  activity  Activity?      @relation(fields: [activityId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])
  photos    GalleryPhoto[]

  @@map("gallery_albums")
}

model GalleryPhoto {
  id        String   @id @default(uuid())
  albumId   String   @map("album_id")
  imageUrl  String   @map("image_url")
  caption   String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  album GalleryAlbum @relation(fields: [albumId], references: [id])

  @@index([albumId], name: "idx_gallery_album")
  @@map("gallery_photos")
}

model Campaign {
  id          String         @id @default(uuid())
  title         String
  description   String?
  coverImageUrl String?        @map("cover_image_url")
  goalCents     Int            @map("goal_cents")
  startDate   DateTime       @map("start_date") @db.Date
  endDate     DateTime       @map("end_date") @db.Date
  status      CampaignStatus @default(DRAFT)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  orders Order[]

  @@index([status], name: "idx_campaigns_status")
  @@map("campaigns")
}

model Invite {
  id         String       @id @default(uuid())
  email      String
  role       Role
  tokenHash  String       @map("token_hash")
  status     InviteStatus @default(PENDING)
  invitedById String      @map("invited_by")
  expiresAt  DateTime     @map("expires_at")
  acceptedAt DateTime?    @map("accepted_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  invitedBy User @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([email, status], name: "idx_invites_email_status")
  @@index([tokenHash], name: "idx_invites_token_hash")
  @@map("invites")
}
